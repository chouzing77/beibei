{
  "name": "beibei-desktop",
  "version": "1.0.0",
  "description": "背背：理解、意群积木与间隔复习",
  "author": "背背",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable --x64 --publish never",
    "test": "node --test tests/*.test.cjs"
  },
  "devDependencies": {
    "7zip-bin": "^5.2.0",
    "electron": "44.9.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "cn.beibei.desktop",
    "productName": "背背",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "protocol.cjs",
      "web/**/*",
      "assets/**/*"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "背背",
      "runAfterFinish": false,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Beibei-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "Beibei-Portable-${version}-${arch}.${ext}"
    }
  }
}
